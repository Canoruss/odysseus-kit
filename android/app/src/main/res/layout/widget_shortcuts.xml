<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center"
    android:background="@drawable/widget_bg">
    <TextView
        android:id="@+id/s_chat"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/w_sc_chat"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/s_translate"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/w_sc_translate"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/s_task"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/w_sc_task"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/s_voice"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/w_sc_speak"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/s_expense"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/w_sc_expense"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
