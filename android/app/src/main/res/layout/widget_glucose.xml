<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glucose_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp"
    android:background="@drawable/widget_glucose_round">
    <TextView android:id="@+id/glucose_value"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/glucose_no_data" android:textColor="#FFFFFF"
        android:textStyle="bold" android:textSize="16sp" android:gravity="center" />
    <TextView android:id="@+id/glucose_time"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#CBD5E1" android:textSize="9sp" android:gravity="center" />
</LinearLayout>
