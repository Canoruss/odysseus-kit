+# Background loops call the config resolver every minute; warn about a missing
+# SMTP/IMAP setup once per process instead of flooding the log.
+_CFG_WARNED: set[str] = set()
+
+
+def _warn_cfg_once(key: str, msg: str) -> None:
+    if key not in _CFG_WARNED:
+        _CFG_WARNED.add(key)
+        logger.warning(msg)
+
 
